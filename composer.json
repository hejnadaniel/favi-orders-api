{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "phpdocumentor/type-resolver": "^2.0",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "lint:fix": "@php vendor/bin/php-cs-fixer fix",
        "stan": [
            "@php bin/console cache:warmup --env=dev --quiet",
            "@php vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "test": "@php vendor/bin/phpunit",
        "openapi:lint": "npx --yes @stoplight/spectral-cli lint docs/openapi.yaml",
        "schema:validate": "@php bin/console doctrine:schema:validate --skip-sync",
        "db:test:reset": [
            "@php bin/console doctrine:database:drop --if-exists --force --env=test",
            "@php bin/console doctrine:database:create --env=test",
            "@php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration --env=test"
        ],
        "check": [
            "@lint",
            "@stan",
            "@openapi:lint",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*"
    },
    "scripts-descriptions": {
        "lint": "Check coding style (php-cs-fixer, dry run)",
        "lint:fix": "Fix coding style",
        "stan": "Static analysis (PHPStan level max, strict rules)",
        "test": "PHPUnit test suite",
        "openapi:lint": "Lint docs/openapi.yaml with Spectral",
        "schema:validate": "Validate Doctrine mapping against the schema",
        "db:test:reset": "Drop, create and migrate the test database",
        "check": "lint + stan + openapi:lint + test"
    }
}
